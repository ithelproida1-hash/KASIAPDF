# ---------------------------------------------------------------------------
# Public configuration (safe to expose in the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Jindal Kasia PDF"

# ---------------------------------------------------------------------------
# Stirling-PDF (server-side only — never prefix these with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Local development
STIRLING_PDF_URL="http://localhost:8080"
# Production: the Cloudflare Tunnel hostname, e.g. https://pdf-engine.example.com
# STIRLING_PDF_URL="https://pdf-engine.example.com"

# Only required when Stirling login is enabled. Send as X-API-KEY.
STIRLING_PDF_API_KEY=""

# If the tunnel endpoint is protected by Cloudflare Access, create a service
# token (Access → Service Auth) and set both values. Server-side only.
CLOUDFLARE_ACCESS_CLIENT_ID=""
CLOUDFLARE_ACCESS_CLIENT_SECRET=""

# Phase 1 synchronous processing limits (milliseconds)
STIRLING_TIMEOUT_MS="120000"
STIRLING_HEALTH_TIMEOUT_MS="4000"

# ---------------------------------------------------------------------------
# Upload limits
# NOTE: Vercel Functions accept ~4.5 MB request bodies. Use 4/4 there;
# the defaults below are for local or self-hosted deployments.
# ---------------------------------------------------------------------------
MAX_FILE_SIZE_MB="100"
MAX_FILES_PER_JOB="10"
MAX_TOTAL_UPLOAD_MB="250"
RATE_LIMIT_PER_MINUTE="30"

# ---------------------------------------------------------------------------
# Local upload backup
# Every accepted upload is copied here before it is sent to the engine, grouped
# by date. Use an absolute path (forward slashes work on Windows). Set "off" to
# disable, which is recommended for servers without persistent disk.
# ---------------------------------------------------------------------------
UPLOAD_BACKUP_DIR="storage/uploads"

# ---------------------------------------------------------------------------
# Optional: Supabase (not used in Phase 1 — leave blank)
# ---------------------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Optional: Cloudflare R2 (not used in Phase 1 — leave blank)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# ---------------------------------------------------------------------------
# Optional: SSRF allowlist for URL-based tools (Phase 3)
# Comma-separated hostnames that may be fetched even if they resolve internally.
# ---------------------------------------------------------------------------
URL_ALLOWLIST=""